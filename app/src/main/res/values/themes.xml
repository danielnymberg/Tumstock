<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DaNy Apps-tema: varmt papper + bläck, alltid ljust (som danyapps.se). -->
    <style name="Theme.Matverktyg" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:colorBackground">@color/paper</item>
        <item name="colorSurface">@color/paper</item>
        <item name="colorSurfaceContainer">@color/paper_2</item>
        <item name="colorSurfaceContainerHigh">@color/paper_2</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/ink_3</item>
        <item name="colorPrimary">@color/ink</item>
        <item name="colorOnPrimary">@color/paper</item>
        <item name="colorSecondaryContainer">@color/paper_2</item>
        <item name="colorOnSecondaryContainer">@color/ink</item>
        <item name="colorOutline">@color/ink_mute</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="DaNy.Meta" parent="">
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.22</item>
        <item name="android:textColor">@color/ink_mute</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="DaNy.SectionLabel" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.2</item>
        <item name="android:textColor">@color/ink_mute</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
